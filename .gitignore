# Local docker env — per-environment, never committed. The canonical
# reference is docker-compose.example.yml; each host keeps its own
# docker-compose.yml (copy the example and adjust). Secrets live in .env.
.env
docker-compose.yml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Node / Next.js — never commit build artefacts or installed deps
node_modules/
.next/
dashboard/tsconfig.tsbuildinfo

# (Alertmanager secrets now live in .env — read at container
# start by the alertmanager-init service in docker-compose.yml. The
# on-disk monitoring/alertmanager/secrets/ tree was retired.)
